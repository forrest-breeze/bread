# Login-page access gate. Leave unset to disable. This is server-only; never
# expose the value through a NEXT_PUBLIC_ variable in new deployments.
LOGIN_ACCESS_CODE=

# Supabase
# Use the new key types (Supabase retires anon/service_role keys end of 2026).
# The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY names
# still work as a fallback. Keep the NEXT_PUBLIC_ prefix: without it Next.js
# won't expose the value to the browser client.
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
# sb_secret_...
SUPABASE_SECRET_KEY=


# AWS S3 — large binary asset store (images/video/audio attachments, and
# oversized document bodies). Entirely opt-in: leave S3_BUCKET unset and the
# app behaves exactly as before (capture attachments are not persisted). When
# set, image/video attachments and document-editor
# embeds upload here instead of being dropped or entering Supabase Storage.
# Editor uploads use signed browser PUTs; the bucket CORS policy must allow PUT
# from the app origin with the Content-Type and Cache-Control headers.
# See src/lib/storage/{s3,blob-store,media}.ts.
#   S3_BUCKET                 (required to enable) target bucket name.
#   S3_REGION                 bucket region (falls back to AWS_REGION, then us-east-1).
#   S3_ACCESS_KEY_ID          scoped access key (must be paired with secret).
#   S3_SECRET_ACCESS_KEY      scoped secret (must be paired with access key).
#   S3_SESSION_TOKEN          optional temporary-credential session token.
#                             When no explicit pair is set, AWS deployments use
#                             the SDK default IAM role/provider chain. Partial
#                             or mixed S3_*/AWS_* pairs fail closed.
#   S3_ENDPOINT               (optional) custom endpoint for S3-compatible
#                             stores (Cloudflare R2, MinIO, Backblaze B2).
#   S3_FORCE_PATH_STYLE       (optional) set 1 for MinIO-style path addressing.
#   S3_PUBLIC_BASE_URL        (optional) CDN/public origin for unsigned reads;
#                             without it, reads use time-limited signed URLs.
#   S3_OFFLOAD_THRESHOLD_BYTES (optional) text body size that triggers S3
#                             offload (default 262144 = 256 KiB).
# Never use root credentials, never prefix these variables with NEXT_PUBLIC_,
# and leave S3_PUBLIC_BASE_URL empty unless a separately access-controlled CDN
# is intentional. See docs/s3-media-security.md for least-privilege policies,
# exact application limits, CORS, and AWS-vs-R2 guidance.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
S3_PUBLIC_BASE_URL=
S3_OFFLOAD_THRESHOLD_BYTES=


# Integration token encryption (AES-256-GCM). Encrypts integration credentials
# (Linear/Granola/Drive PATs, Slack bot tokens) in the app before storing them.
# REQUIRED to connect any token-based integration — without it, connect fails
# with "Token encryption is not configured." 32 bytes, base64 or hex.
# Generate with:  openssl rand -base64 32
BREEZIFY_TOKEN_ENC_KEY=


# AI providers: Anthropic is the approved AI provider for this tool, used only
# for two optional portal features.
# Embeddings, the portal agent / AI builder and website-import synthesis remain
# removed, and search is keyword-only. Do NOT add Gemini, DeepSeek, Kimi,
# OpenAI, OpenRouter or Groq keys here or in Vercel.
#
# ANTHROPIC_API_KEY (server-only; never prefix with NEXT_PUBLIC_) enables the
# public portal "Ask AI" assistant (/api/public/ask, claude-opus-5-5) and portal
# machine translation (/api/public/translate, claude-haiku-5-5). Leave it unset
# and both features stay off: the builder shows a setup hint and the routes
# return 503. Published portal content and visitor questions are sent to
# Anthropic when it is set. Translations are cached in Upstash (below) when
# configured.
ANTHROPIC_API_KEY=

# Cron / scheduled ingestion
# Shared bearer secret for the scheduled-ingest fan-out (/api/cron/ingest-all),
# the GitHub retry-sweep (/api/github/sweep), and stale-proposal cleanup
# (/api/sweep/cleanup), and media GC (/api/cron/media-gc). Must also be set as a
# `CRON_SECRET` repo secret (alongside `BREEZIFY_APP_URL`) for the cron-kb-media-gc
# GitHub Action.
CRON_SECRET=

# Slack
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Shared bearer secret for the scheduled monitored-channel poll (/api/slack/sync-all)
SLACK_CRON_SECRET=
# Optional single-workspace fallback bot token — only used if a workspace has
# no OAuth-connected Slack integration in the DB. Multi-tenant prod normally
# doesn't need this.
SLACK_BOT_TOKEN=


# Instagram inbound automations (see docs/instagram-inbound-automations.md).
#
# ONE Meta app exposes TWO id/secret pairs, and they are not interchangeable:
#   Meta app pair       App settings → Basic. Signs webhook deliveries.
#   Instagram app pair  Instagram → API setup with Instagram business login.
#                       Authenticates Instagram Business Login (OAuth).
# Sending the Meta app id to instagram.com/oauth/authorize fails with
# "Invalid Request: Request parameters are invalid: Invalid platform app".
#
# --- Meta app pair (webhooks) ---
# Verifies X-Hub-Signature-256 on every delivery.
INSTAGRAM_APP_SECRET=
# Any random string; must match the value entered in the Meta app dashboard.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# The Meta app id. Used as the OAuth client_id ONLY when INSTAGRAM_OAUTH_APP_ID
# below is unset.
INSTAGRAM_APP_ID=
#
# --- Instagram app pair (OAuth) ---
# Powers the one-click "Connect Instagram" button at /social/instagram, which
# is also what mints the account access token — there is no manual token step.
# Set both, or neither: an Instagram app id will NOT fall back to
# INSTAGRAM_APP_SECRET, because that secret belongs to the other app.
# Leave both blank only when the two apps genuinely share credentials.
INSTAGRAM_OAUTH_APP_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=
# Pins the exact redirect_uri sent to Instagram. Instagram requires it to match
# a registered value byte for byte AND to be HTTPS — so the derived
# NEXT_PUBLIC_APP_URL value (http://localhost:3001 in dev) is always rejected
# locally. Set this to the URI registered on the Meta app to develop against it:
#   https://app.example.com/api/ops/instagram/oauth/callback
# Leave blank in production, where the derived value is already correct.
INSTAGRAM_OAUTH_REDIRECT_URI=
# Optional. Default targets the Instagram Login path (no Facebook Page needed).
# Set to https://graph.facebook.com if the account is connected via a linked Page.
INSTAGRAM_GRAPH_BASE=
INSTAGRAM_GRAPH_VERSION=
# Account access tokens are NOT set here — they are encrypted at rest with
# BREEZIFY_TOKEN_ENC_KEY via POST /api/ops/instagram/accounts.


# App URL (used in Navbar and Footer links; dev values live in .env.development)
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_APP_URL=https://app.example.com

# Auth cookie scope. Set to ".example.com" so the session cookie is shared across
# the app host and custom KB portal domains — required for private-portal login
# on a custom domain to survive the redirect (see lib/portal/login-return.ts).
# Leave blank locally.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=


# Resend (invite emails, demo request notifications)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Breezify <noreply@example.com>
DEMO_REQUEST_NOTIFY_EMAIL=

# "What's new" feed source: the public changelog portal the dashboard top bar
# reads, as "<workspaceSlug>/<projectSlug>". Defaults to breezify/changelog.
BREEZIFY_CHANGELOG_PORTAL=


# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# API host. Passed straight to the PostHog SDK, which applies its own default
# (us.i.posthog.com) when this is blank. Set for EU/self-hosted instances.
NEXT_PUBLIC_POSTHOG_HOST=
# Set to 1 to also capture analytics in local development. Off by default so dev
# activity does not pollute production funnels (instrumentation-client.ts).
NEXT_PUBLIC_POSTHOG_ENABLE_DEV=

# GitHub
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PKCS#1 DER, base64-encoded, single line, no spaces — produce with:
#   openssl rsa -in key.pem -outform DER | base64 | tr -d '\n'
# Do NOT paste raw .pem contents, and do NOT `base64 key.pem` (the old
# pre-migration format). The runtime rejects both formats with an explicit
# error pointing back to this recipe; see parseAppPrivateKey in
# apps/web/app/src/lib/github/github.ts.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Linear
# Personal API keys are minted by each workspace admin in the Linear UI
# (Settings → Account → API). The cron secret protects /api/linear/sync-all.
LINEAR_CRON_SECRET=

# Google Drive
# OAuth client credentials from console.cloud.google.com (Web application
# type). Redirect URI must be ${NEXT_PUBLIC_APP_URL}/api/google-drive/auth/callback.
# Scopes requested: drive.readonly + userinfo.email + userinfo.profile.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Independent HMAC secret for signing OAuth state. Generate with:
#   openssl rand -hex 32
GOOGLE_DRIVE_STATE_SECRET=
# Bearer secret protecting /api/google-drive/sync-all.
GOOGLE_DRIVE_CRON_SECRET=

# Cloudflare portal connector
# OAuth client type: server-side Authorization Code, client_secret_post.
# Redirect URI must be:
#   ${NEXT_PUBLIC_APP_URL}/api/cloudflare/oauth/callback
# Configure the client with authorization_code + refresh_token grants and the
# Zone Read, Workers Scripts Write, and Workers Routes Write scopes.
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
# Optional space/comma-separated subset of the scopes configured on the OAuth
# client (dot-notation scope IDs, e.g. "zone.read workers-scripts.write
# workers-routes.write"). Leave empty to request the client's default scopes.
CLOUDFLARE_OAUTH_SCOPES=
# Optional explicit origin baked into deployed portal-proxy Workers as
# BREEZIFY_ORIGIN. Defaults to NEXT_PUBLIC_APP_URL; loopback hosts (localhost
# dev servers) are replaced with https://app.example.com because an edge Worker
# can never reach them.
BREEZIFY_PORTAL_PROXY_ORIGIN=

# Granola
# Bearer secret protecting /api/granola/sync-all.
GRANOLA_CRON_SECRET=

# Feature gates
# The Breezify team workspace id — dogfood-only features (e.g. Workflows) are
# restricted to this workspace. Unset / empty = those features are hidden
# in every workspace (fail closed; a one-shot console.warn is emitted in
# non-production). Must be `NEXT_PUBLIC_*` because the sidebar gate runs
# in the browser. See src/lib/feature-gates.ts.
NEXT_PUBLIC_BREEZIFY_WORKSPACE_ID=

# Upstash Redis (cross-container GitHub installation-token cache)
# Both docs now live in the Breezify KB, not this repo: "GitHub Token Cache"
# (design) and "Upstash Redis — Provisioning Runbook" (where to copy these two
# values from). Console → your database → REST API section.
# Leave unset to fall back to a per-container in-memory cache (zero ceremony,
# cache hit rate just drops to per-container scope).
# NOTE: this database also serves as the fallback source for the GitHub App
# private key (key "github:app:private-key", written by `npm run github:app-key`)
# when GITHUB_APP_PRIVATE_KEY is unset. If both are empty, every GitHub call
# fails before it is made.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Capture buffer / librarian sweep tuning (see src/lib/capture/thresholds.ts)
# BREEZIFY_MIN_CAPTURE_WORDS — ingress rejects text captures with fewer words
#   than this (a low junk floor; default 5). Screenshot-only captures exempt.
# BREEZIFY_SWEEP_WORD_THRESHOLD — the sweep wakes once the held pile reaches this
#   many words total (default 300). Replaces the old fixed 5-capture count.
# BREEZIFY_DISABLE_COUNT_TRIGGER=1 — disable the auto-trigger entirely (seed
#   scripts set this so a whole batch lands before any sweep fires).
BREEZIFY_MIN_CAPTURE_WORDS=
BREEZIFY_SWEEP_WORD_THRESHOLD=
BREEZIFY_DISABLE_COUNT_TRIGGER=

# Public Knowledge Base
# NEXT_PUBLIC_PUBLIC_KB_BASE_DOMAIN — when set (e.g. "example.com"), a published
#   workspace KB is reachable at "<handle>.<base>" (e.g. acme.example.com). The
#   proxy resolves the handle to the owning workspace and rewrites to /p/<slug>.
#   Leave unset to keep only the clean /p/<slug> path.
#   Infra required: a wildcard DNS record (*.<base>) and a wildcard TLS cert
#   pointed at this app. If <base> is the bare apex the app already lives under
#   (app.<base>), that app host plus reserved labels (www, api, mail, ...) are
#   excluded from rewriting — see RESERVED_HANDLES in
#   src/lib/public-kb-handle.ts; the same list blocks claiming those handles.
# A workspace admin can additionally point a fully custom domain at the public
#   KB from Settings → Workspace; that resolves to the workspace by host with
#   no extra env needed.
NEXT_PUBLIC_PUBLIC_KB_BASE_DOMAIN=
# NEXT_PUBLIC_PORTAL_CNAME_TARGET — the CNAME target shown to customers in the
#   "Custom domain" DNS instructions (Settings → Workspace). Defaults to the
#   branded app host "app.example.com" (which resolves to the hosting platform). Prefer a
#   dedicated, decoupled record (e.g. "cname.example.com" -> the Vercel host)
#   once it exists, so customer DNS isn't chained through the live app host.
NEXT_PUBLIC_PORTAL_CNAME_TARGET=
# Absolute origin used for Next.js framework assets when a portal is rendered
# below a customer's path. Vercel primary production deployments infer
# this from NEXT_PUBLIC_APP_URL; set it explicitly on another platform.
BREEZIFY_PORTAL_ASSET_ORIGIN=


# Portal analytics (portal_events capture — see src/lib/portal/analytics-capture.ts)
# BREEZIFY_PORTAL_VISITOR_SALT       server secret mixed into the cookieless visitor
#                                  hash. Defaults to a shared fallback salt if unset
#                                  — set a real one so visitor hashing isn't guessable.
# BREEZIFY_PORTAL_ANALYTICS_DISABLED=1  kill-switch, sheds all portal_events writes.
# BREEZIFY_PORTAL_ANALYTICS_FORCE=1     capture in dev/localhost too (off by default
#                                  so local testing doesn't inflate prod counts).
BREEZIFY_PORTAL_VISITOR_SALT=
BREEZIFY_PORTAL_ANALYTICS_DISABLED=
BREEZIFY_PORTAL_ANALYTICS_FORCE=

# Set to 1 to skip the per-keystroke search-telemetry insert (see
# src/lib/ops/telemetry.ts) if it's competing with auth writes under load.
BREEZIFY_SEARCH_TELEMETRY_DISABLED=

# CLI-only admin backfill routes (/api/admin/backfill-embeddings,
# /api/admin/backfill-sections). Fails closed when unset — do NOT deploy
# these routes without it.
BREEZIFY_CLI_API_KEY=

# TEMPORARY: skip the magic-link email locally (never works in prod/Vercel).
# Remove once Resend is verified. See src/lib/auth/dev-login-bypass.ts.
NEXT_PUBLIC_AUTH_DEV_BYPASS=true
