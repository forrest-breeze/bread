              "USD",
              "EUR"
            ]
          },
          "ready": {
            "type": "object",
            "properties": {
              "settlementDate": {
                "type": "number"
              },
              "amountMinor": {
                "type": "number"
              },
              "percent": {
                "type": "number"
              }
            },
            "required": [
              "amountMinor",
              "percent"
            ],
            "description": "Amount ready in the next upcoming settlement; `settlementDate` is its expected transfer time (unix ms)."
          },
          "scheduled": {
            "type": "object",
            "properties": {
              "amountMinor": {
                "type": "number"
              },
              "percent": {
                "type": "number"
              }
            },
            "required": [
              "amountMinor",
              "percent"
            ],
            "description": "Amount across settlements scheduled after the next one."
          },
          "pending": {
            "type": "object",
            "properties": {
              "amountMinor": {
                "type": "number"
              },
              "percent": {
                "type": "number"
              }
            },
            "required": [
              "amountMinor",
              "percent"
            ],
            "description": "Balance not yet allocated to a settlement: total − ready − scheduled, so negative in a deficit."
          }
        },
        "required": [
          "asOf",
          "totalBalanceMinor",
          "currency",
          "ready",
          "scheduled",
          "pending"
        ],
        "description": "`GET /v1/dashboard/payin-balance`",
        "definitions": {}
