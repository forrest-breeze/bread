{
  "name": "breezify-monorepo",
  "private": true,
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "apps/*",
    "apps/web/app",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "node scripts/repo-coverage.mjs",
    "seed:breezify-docs": "NODE_OPTIONS=--conditions=react-server npx tsx --tsconfig apps/web/app/tsconfig.json apps/web/app/scripts/seed-breezify-docs.ts",
    "github:app-key": "npx tsx --tsconfig apps/web/app/tsconfig.json apps/web/app/scripts/put-github-app-key.ts",
    "clean": "turbo run clean",
    "prune": "npm run clean && find . -name '.turbo' -type d -prune -exec rm -rf {} +",
    "deploy:preview": "bash scripts/deploy.sh preview",
    "deploy:prod": "bash scripts/deploy.sh prod",
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:migration:new": "supabase migration new",
    "db:migration:list": "supabase migration list",
    "db:migration:up": "supabase migration up",
    "db:migration:fetch": "supabase migration fetch --linked",
    "db:migration:repair": "supabase migration repair",
    "db:diff": "supabase db diff -f",
    "db:pull": "supabase db pull",
    "db:push": "supabase db push",
    "db:push:dry": "supabase db push --dry-run",
    "db:lint": "supabase db lint"
  },
  "devDependencies": {
    "balanced-match": "^4.0.4",
    "jsdom": "^26.1.0",
    "onetime": "^5.1.2",
    "react-refresh": "^0.18.0",
    "supabase": "^2.105.0",
    "tr46": "^6.0.0",
    "turbo": "^2.5.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "axios": "^1.18.1",
    "body-parser": "^2.3.0",
    "dompurify": "^3.4.12",
    "serialize-javascript": "^7.0.5",
    "elliptic": "^6.6.1",
    "fast-uri": "^3.1.4",
    "hono": "^4.12.32",
    "js-yaml": "^4.3.0",
    "linkify-it": "^5.0.2",
    "next": {
      "postcss": "^8.5.23",
      "sharp": "^0.35.3"
    },
    "vite": {
      "esbuild": "^0.28.1"
    },
    "katex": "^0.18.2",
    "minimatch@>=7 <11.0.1": "^11.0.1",
    "postcss-selector-parser@<6.1.5": "^6.1.6"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true,
    "core-js": false
  }
}
